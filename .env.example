NODE_ENV=development
PORT=3001

# Banco (PostgreSQL) — database e role próprios do serviço (ADR-012)
DATABASE_URL=postgres://oficina:senha123@localhost:5433/oficina_billing

# Segurança — o mesmo JWT_SECRET do OS Service e da Lambda de auth (RFC-003)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Serviço-a-serviço e aprovação externa
INTERNAL_API_TOKEN=change-this-internal-token
WEBHOOK_SECRET=change-this-webhook-secret

# Mensageria (SQS/SNS). MESSAGING_DRIVER=memory roda sem AWS; MESSAGING_ENABLED=false roda só a API.
MESSAGING_DRIVER=sqs
MESSAGING_ENABLED=true
BILLING_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/billing-commands
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-eventos
OUTBOX_RELAY_INTERVAL_MS=1000

# Pagamento: fake (sem conta) ou mercadopago (sandbox: credencial TEST-…)
PAYMENT_GATEWAY=fake
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública do webhook (API Gateway) e para onde o MP devolve o comprador
MP_NOTIFICATION_URL=
MP_BACK_URL=
PAGAMENTO_TTL_MINUTOS=60
PUBLIC_BASE_URL=http://localhost:3003

# Notificação de orçamento: smtp (Mailhog em dev) ou ses
NOTIFICATION_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@oficina.com

# AWS (LocalStack em dev; no EKS vem da LabRole via IMDS)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info

# New Relic (sem licença o agente fica desabilitado)
NEW_RELIC_APP_NAME=billing-service
NEW_RELIC_LICENSE_KEY=
